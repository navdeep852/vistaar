{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VISTAAR",
  "version": "1.0.0",
  "identifier": "com.grovyx.vistaar",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VISTAAR",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "GROVYX",
    "copyright": "Copyright © 2026 GROVYX. All rights reserved.",
    "shortDescription": "VISTAAR Business OS — Run Better. Grow Wider.",
    "longDescription": "VISTAAR Business OS is a high-performance ERP, Billing, Inventory, Accounting and Enterprise Business Management suite.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
